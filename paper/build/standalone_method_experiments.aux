\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Architectures of the two learned Stage\nobreakspace  {}2 branches. (a) Stage\nobreakspace  {}2a combines mask-aware pre-event image features with deployable geometry to estimate three building-type probabilities. Their five-model mean informs a separately fitted ridge-plus-residual exposure model. (b) Stage\nobreakspace  {}2b applies a weight-shared backbone to paired observations, pools footprint and context features, and combines state and change evidence in a cumulative ordinal head.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:stage2_architecture}{{4}{7}{Architectures of the two learned Stage~2 branches. (a) Stage~2a combines mask-aware pre-event image features with deployable geometry to estimate three building-type probabilities. Their five-model mean informs a separately fitted ridge-plus-residual exposure model. (b) Stage~2b applies a weight-shared backbone to paired observations, pools footprint and context features, and combines state and change evidence in a cumulative ordinal head}{figure.4}{}}
\newlabel{eq:ranking_score}{{9}{7}{Stage 3: Coverage-Aware Multi-Date Synthesis}{equation.1.9}{}}

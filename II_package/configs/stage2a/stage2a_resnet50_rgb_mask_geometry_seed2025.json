{
  "labels_csv": "outputs/stage2a/ml_dataset/labels_manifest.csv",
  "out_dir": "outputs/stage2a/backbone_sweeps/resnet50_rgb_mask_geometry_seed2025",
  "seed": 2025,
  "epochs": 50,
  "batch_size": 64,
  "lr": 0.0001,
  "weight_decay": 0.01,
  "alpha_pop": 1.0,
  "beta_type": 0.5,
  "loss_pop": "huber",
  "class_weight_mode": "inverse_sqrt",
  "val_ratio": 0.15,
  "test_ratio": 0.15,
  "amp_dtype": "bf16",
  "ema_decay": 0.999,
  "early_stop_patience": 8,
  "backbone_name": "resnet50",
  "input_mode": "rgb_mask_geometry",
  "task_mode": "multitask",
  "type_conditioning_mode": "none",
  "geometry_cols": "log_footprint_m2,mask_fill_ratio,bbox_aspect_ratio,geometry_compactness,estimated_units_missing,GEOID_missing",
  "sampler_mode": "weighted",
  "population_clip_quantile": 0.995,
  "population_bin_balance": false,
  "img_size": 224,
  "pretrained": true,
  "save_val_predictions": true
}

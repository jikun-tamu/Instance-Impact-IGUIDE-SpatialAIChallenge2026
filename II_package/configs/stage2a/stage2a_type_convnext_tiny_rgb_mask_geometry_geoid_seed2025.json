{
  "labels_csv": "outputs/stage2a/ml_dataset/labels_manifest.csv",
  "out_dir": "outputs/stage2a/type_experiments/m10_convnext_tiny_rgb_mask_geometry_geoid_seed2025",
  "seed": 2025,
  "epochs": 50,
  "batch_size": 48,
  "lr": 0.00005,
  "weight_decay": 0.01,
  "alpha_pop": 0.0,
  "beta_type": 1.0,
  "loss_pop": "huber",
